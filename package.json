{
  "name": "pw_2026_cucumberbdd",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test-dry": "cucumber-js --dry-run --format summary",
    "test:qa": "cross-env ENV=qa npx cucumber-js",
    "test:prod": "cross-env ENV=prod npx cucumber-js",
    "test:headless": "cross-env HEADLESS=true npx cucumber-js",
    "test:chromium": "cross-env BROWSER=chromium npx cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox npx cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit npx cucumber-js",
    "test:chromium-headless": "cross-env BROWSER=chromium HEADLESS=true npx cucumber-js",
    "test:firefox-headless": "cross-env BROWSER=firefox HEADLESS=true npx cucumber-js",
    "test:webkit-headless": "cross-env BROWSER=webkit HEADLESS=true npx cucumber-js",
    "test:parallel": "npx cucumber-js --parallel 4",
    "test:all-browsers": "npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:all-browsers-headless": "npm run test:chromium-headless && npm run test:firefox-headless && npm run test:webkit-headless",
    "test:login": "cucumber-js src/features/login.feature",
    "test:products": "cucumber-js src/features/product.feature",
    "report:generate": "allure generate allure-results --clean -o reports/allure-report",
    "report:open": "allure open allure-report",
    "test:report": "npm run test && npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "allure-cucumberjs": "^3.10.2",
    "allure-js-commons": "^3.10.2",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
